// rearmed effect shaders (generated by tools/make_textures.py)

rearmed/flame
{
	nopicmip
	cull none
	{
		clampmap gfx/rearmed/glow.tga
		blendFunc GL_SRC_ALPHA GL_ONE
		rgbGen vertex
		alphaGen vertex
	}
}

rearmed/wetShell
{
	deformVertexes wave 100 sin 1.2 0 0 0
	{
		map textures/effects/regenmap2.tga
		blendfunc GL_ONE GL_ONE
		tcGen environment
		tcmod scroll 0 -0.9
		rgbGen const ( 0.08 0.28 0.7 )
	}
}

rearmed/vampireShell
{
	deformVertexes wave 100 sin 2 0 0 0
	{
		map textures/effects/regenmap2.tga
		blendfunc GL_ONE GL_ONE
		tcGen environment
		tcmod rotate 60
		tcmod scroll 0.6 0.2
		rgbGen wave sin 0.6 0.4 0 1.5
	}
}

rearmed/rapidShell
{
	deformVertexes wave 100 sin 1.5 0 0 0
	{
		map textures/effects/envmapgold2.tga
		blendfunc GL_ONE GL_ONE
		tcGen environment
		tcmod scroll 2 0.5
		rgbGen const ( 1.0 0.55 0.1 )
	}
}

