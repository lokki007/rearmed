// rearmed v4 random events + slow motion screen effects (generated by tools/make_events_gfx.py)

rearmed/evFilter
{
	nopicmip
	{
		map $whiteimage
		blendFunc GL_DST_COLOR GL_ZERO
		rgbGen vertex
	}
}

rearmed/evFlash
{
	nopicmip
	{
		map $whiteimage
		blendFunc GL_ONE GL_ONE
		rgbGen vertex
	}
}

rearmed/evVignette
{
	nopicmip
	nomipmaps
	{
		clampmap gfx/rearmed/events/vignette.tga
		blendFunc blend
		rgbGen vertex
		alphaGen vertex
	}
}

rearmed/evTopGlow
{
	nopicmip
	nomipmaps
	{
		clampmap gfx/rearmed/events/topglow.tga
		blendFunc GL_ONE GL_ONE
		rgbGen vertex
	}
}

rearmed/evFrost
{
	nopicmip
	nomipmaps
	{
		clampmap gfx/rearmed/events/frost.tga
		blendFunc blend
		rgbGen vertex
		alphaGen vertex
	}
}
