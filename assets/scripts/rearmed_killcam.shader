// rearmed 0.5 kill cam / replay panel (generated by tools/make_killcam_gfx.py)

rearmed/kcGrain
{
	nopicmip
	{
		map gfx/rearmed/killcam/grain.tga
		blendFunc GL_DST_COLOR GL_SRC_COLOR
		rgbGen identity
	}
}

rearmed/kcVignette
{
	nopicmip
	nomipmaps
	{
		clampmap gfx/rearmed/killcam/vignette.tga
		blendFunc blend
		rgbGen vertex
		alphaGen vertex
	}
}
