// REARMED DESCENT v2 loot: gems, the vacuum magnet, chests (generated by tools/blender/make_loot.py)

models/rearmed/loot/gem0
{
	nopicmip
	{
		map models/rearmed/loot/gem0.tga
		rgbGen identity
	}
	{
		map models/rearmed/loot/gemenv.tga
		blendFunc GL_ONE GL_ONE
		tcGen environment
		rgbGen wave sin 0.7 0.3 0.0 0.9
	}
}

