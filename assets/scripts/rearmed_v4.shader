models/rearmed/props/barrel
{
	{
		map models/rearmed/props/propenv.tga
		tcGen environment
		rgbGen lightingDiffuse
	}
	{
		map models/rearmed/props/barrel.tga
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen lightingDiffuse
	}
	{
		map models/rearmed/props/barrel_glow.tga
		blendFunc GL_ONE GL_ONE
		rgbGen wave sin 0.7 0.3 0 0.55
	}
}

